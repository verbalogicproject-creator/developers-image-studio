// =========================================================================
// IMAGEN NANO BANANA IMAGE STUDIO V2 & MEMORY OS — ARCHITECTURE SPEC
// =========================================================================

// -------------------------------------------------------------------------
// COMPONENT ROLES & RESPONSIBILITIES
// -------------------------------------------------------------------------

@component OrchestratorTab {
  responsibility: "Master control plane. Directs commercial domains, lighting, composition, typography, and viral editorial themes."
  file: "components/OrchestratorTab.tsx"
  state_dependencies: ["useStudioStore.pipelineMode", "useStudioStore.domain", "useStudioStore.postCategory"]
}

@component StudioTab {
  responsibility: "Primary generation interface. Real-time prompt and copy input, viewport, model status, and gallery history."
  file: "components/StudioTab.tsx"
  state_dependencies: ["useStudioStore.pipelineMode", "useStudioStore.headlineText", "useStudioStore.currentGeneration"]
}

@component CanvasMask {
  responsibility: "Touch-optimized HTML5 Canvas overlay for inpainting masks. Renders high-DPI scaled strokes with zero touch drift."
  file: "components/CanvasMask.tsx"
  state_dependencies: ["useStudioStore.baseImage", "useStudioStore.maskImage", "useStudioStore.editMode"]
}

@component PromptPreview {
  responsibility: "Live compiled XML prompt inspector and CLI curl generator."
  file: "components/PromptPreview.tsx"
  state_dependencies: ["useStudioStore"]
}

@component Gallery {
  responsibility: "Persistent generation history strip (localStorage max 15 items) with parameter restoration and inpainting bridge."
  file: "components/Gallery.tsx"
  state_dependencies: ["useStudioStore.gallery", "useStudioStore.loadParameters"]
}

@module PromptCompiler {
  responsibility: "Visual Context Prompt Compiler Engine. Translates structured state into XML directives for Gemini Nano Banana 2."
  file: "lib/compiler.ts"
}

@module GenerateApiRoute {
  responsibility: "Next.js backend endpoint (POST /api/generate). Validates Zod schema and invokes @google/genai Node SDK."
  file: "app/api/generate/route.ts"
}

@module GeminiNanoBanana {
  responsibility: "Target multimodal AI model (gemini-3.1-flash-image) generating high-contrast luxury visuals, dark gradient scrims, and sharp typography."
  model_id: "gemini-3.1-flash-image"
}

@module MemoryEngine {
  responsibility: "Local multimodal project memory layer. Manages incremental indexing, semantic code chunking, GraphRAG architectural relations, and hybrid search using node:sqlite."
  file: "memory/engine.ts"
}

// -------------------------------------------------------------------------
// EXPLICIT ARCHITECTURAL RELATIONS & DATA FLOW GRAPH
// -------------------------------------------------------------------------

@relation OrchestratorTab controls MasterPipeline (weight=1.5)
@relation OrchestratorTab controls LightingDirective (weight=1.2)
@relation OrchestratorTab controls CompositionFraming (weight=1.2)
@relation OrchestratorTab controls PackagingTypography (weight=1.4)
@relation OrchestratorTab controls SocialEditorialTheme (weight=1.4)

@relation StudioTab renders ActiveViewport (weight=1.3)
@relation StudioTab triggers PromptCompiler (weight=1.5)
@relation StudioTab calls GenerateApiRoute (weight=1.5)

@relation PromptCompiler produces CompiledPrompt (weight=1.5)
@relation GenerateApiRoute calls GeminiNanoBanana (weight=1.5)
@relation GeminiNanoBanana produces GeneratedImageData (weight=1.5)

@relation Gallery persists GenerationRecord (weight=1.3)
@relation Gallery bridges_to CanvasMask (weight=1.2)
@relation CanvasMask produces BinaryMask (weight=1.4)

@relation MemoryEngine indexes SourceMemory (weight=1.5)
@relation MemoryEngine indexes ArchitecturalMemory (weight=1.5)
@relation MemoryEngine indexes ExperientialMemory (weight=1.5)

// -------------------------------------------------------------------------
// ARCHITECTURAL DECISIONS & RATIONALE
// -------------------------------------------------------------------------

@decision DualPipelineBranching {
  context: "Commercial e-commerce asset generation requires different art direction and constraints than viral social media graphics."
  decision: "Split the compiler and GUI into two distinct pipelines: E-Commerce Studio (<photographer_persona>) and Social Editorial (<editorial_art_director>)."
  consequences: "Eliminates prompt contamination and allows targeted typography scrims for social posts while keeping clean labels for e-commerce."
}

@decision TenLayerSynchronousEvolution {
  context: "Orchestrator, Studio components, Prompt Compiler, Zustand store, and API are tightly coupled across 10 distinct files."
  decision: "Any modification or parameter expansion to the Orchestrator MUST be applied synchronously across all 10 layers mapped in ORCHESTRATOR_SPECS_SOT.md."
  consequences: "Prevents state drift, dropped history parameters, and schema validation crashes."
}

@decision Float32ArrayBlobStorage {
  context: "Storing vector embeddings as JSON strings in SQLite incurs high memory allocation and CPU parsing overhead during retrieval in Termux."
  decision: "Pack Float32Array directly into binary SQLite BLOBs using Buffer.from(vector.buffer, vector.byteOffset, vector.byteLength)."
  consequences: "Achieves zero stringification overhead and fast indexed cosine similarity comparisons."
}

@decision NativeNodeSqlite {
  context: "External vector databases (Chroma, Weaviate, Milvus) and Python dependencies are heavy and unreliable on mobile Termux."
  decision: "Use built-in node:sqlite DatabaseSync with pure TypeScript vector math and FTS5 indexing."
  consequences: "Zero native binary compilation issues, minimal RAM footprint, and instant cold-start capability."
}

// -------------------------------------------------------------------------
// INVARIANTS & CONSTRAINTS (DO NOT BREAK)
// -------------------------------------------------------------------------

@invariant GeminiNanoBananaOnly {
  rule: "Always target gemini-3.1-flash-image via ai.models.generateContent with responseModalities: ['IMAGE']. Never regress to deprecated imagen models."
}

@invariant TenLayerSyncMatrix {
  rule: "All Orchestrator controls must exist synchronously in types/index.ts, lib/schema.ts, lib/constants.ts, lib/store.ts, lib/compiler.ts, OrchestratorTab.tsx, StudioTab.tsx, PromptPreview.tsx, Gallery.tsx, and app/api/generate/route.ts."
}

@invariant NoSSRStateHydrationMismatch {
  rule: "app/page.tsx must maintain a mounted state guard before rendering Zustand localStorage state to prevent SSR hydration errors."
}

@invariant CanvasCoordinateScaling {
  rule: "Touch coordinates in CanvasMask.tsx must always be scaled by (canvas.width / rect.width) to prevent touch drift on high-DPI Android displays."
}
